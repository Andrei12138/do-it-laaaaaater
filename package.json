{
  "name": "do-it-laaaaaater",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "build": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply do-it-laaaaaater-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply do-it-laaaaaater-db --remote",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "animal-island-ui": "1.2.2",
    "classnames": "2.5.1",
    "fflate": "^0.8.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "^5.9.2",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "wrangler": "^4.20.0"
  },
  "engines": {
    "node": ">=22.13 <25"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261123.1": true
  }
}
